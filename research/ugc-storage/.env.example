# Стенд исследования. Файл читается docker compose из этой же директории
# (скопируйте в .env), а скрипты берут те же переменные через os.getenv.
#
# Порты выбраны свободными относительно основного стека проекта: там уже заняты
# 5432/5433 (theatre-db/auth-db), 8123-8126 и 9010-9013 (ClickHouse), 6379, 9200.

# --- Опубликованные хост-порты ---
MONGOS_HOST_PORT=27017
RESEARCH_PG_HOST_PORT=5434
RESEARCH_CH_HTTP_HOST_PORT=8127
RESEARCH_CH_NATIVE_HOST_PORT=9014

# --- MongoDB ---
# Аутентификация на стенде намеренно выключена: keyFile для internal auth в
# шардированном кластере — это ещё пять шагов инициализации, которые к предмету
# исследования (скорость чтения) отношения не имеют.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ugc

# --- PostgreSQL ---
RESEARCH_PG_HOST=localhost
RESEARCH_PG_PORT=5434
RESEARCH_PG_DB=ugc
RESEARCH_PG_USER=research
RESEARCH_PG_PASSWORD=research

# --- ClickHouse ---
RESEARCH_CH_HOST=localhost
RESEARCH_CH_PORT=8127
RESEARCH_CH_DB=ugc
RESEARCH_CH_USER=research
RESEARCH_CH_PASSWORD=research
