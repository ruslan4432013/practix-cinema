PROJECT_NAME="Movie theater"
PROJECT_DESCRIPTION="The best movie theater for averyone"

DEBUG=True
# Плейсхолдер. Сгенерировать свой:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<django-secret-key>

SQL_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=theatre

SQL_HOST=theatre-db
SQL_PORT=5432
SQL_OPTIONS=-c search_path=public,content
DATABASE_TYPE=postgres

# --- Auth service (SSO) integration ---
AUTH_API_URL=http://auth:8000
AUTH_API_TIMEOUT=2.0
AUTH_API_MAX_ATTEMPTS=3

# --- Fallback superuser (ModelBackend, works when Auth is down) ---
DJANGO_SUPERUSER_LOGIN=admin
DJANGO_SUPERUSER_PASSWORD=admin
