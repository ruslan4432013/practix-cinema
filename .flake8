# Конфигурация flake8 для wemake-python-styleguide.
#
# ЗАЧЕМ ВТОРОЙ ЛИНТЕР, ЕСЛИ ЕСТЬ ruff. Они стоят на разных ролях, и роли эти не
# взаимозаменяемы:
#
#   * ruff — ГЕЙТ. Красный ruff в CI ломает сборку, поэтому его набор правил
#     подобран так, чтобы каждое срабатывание было обязательным к исправлению.
#   * wemake-python-styleguide — СОВЕТНИК. Он на порядок строже (сложность,
#     магические числа, вложенность, длина тела `try`), и включать его гейтом на
#     существующем коде значило бы либо переписать репозиторий в один заход,
#     либо утопить конфиг в `noqa` — то есть выключить его же. Его вывод
#     попадает в HTML-отчёт (job `lint-report`, tools/lint_report.py), и
#     замечания там НЕ красят прогон: красный в той job означает «линтер не
#     отработал», а не «в коде есть замечания».
#
# Отсюда правило: НИЧЕГО не отключать здесь ради красивого отчёта — отчёт и
# должен быть длинным, это список долга, а не проверка. Ниже выключены ровно две
# вещи, и обе не несут информации: длина строки (за неё отвечает форматтер) и
# WPS на тестах.
[flake8]
max-line-length = 120

# Длину строки контролирует форматтер; отдельная ошибка на неё только шумит на
# длинных URL и русских комментариях — в конфиге ruff E501 выключен так же.
#
# Больше здесь не отключено НИЧЕГО, и в частности нет строк про кавычки (Q000) и
# RST-докстринги: в wemake-python-styleguide 1.x эти плагины не входят в состав,
# и записи о них были бы конфигурацией несуществующих правил. flake8 такие ключи
# молча игнорирует, поэтому проверить их существование можно только глазами —
# перед добавлением строки сюда убедитесь, что код вообще срабатывает
# (`uv run flake8 --format='%(code)s' apps libs tools | sort | uniq -c | sort -rn`).
extend-ignore = E501

# Список повторяет extend-exclude из [tool.ruff] в pyproject.toml: линтеры
# должны смотреть на ОДИН И ТОТ ЖЕ код, иначе отчёт советника отчитывается за
# файлы, которые гейт вообще не видит (автогенерация Alembic и Django).
exclude =
    .git,
    .venv,
    .nx,
    node_modules,
    __pycache__,
    dist,
    build,
    */migrations/versions/*,
    apps/django-admin/*/migrations/*,
    apps/notifications/src/practix_notifications/*/migrations/*,
    sqlite_to_postgres,
    schema_design,
    practicum-theory

# Тесты по своей природе нарушают половину правил WPS: длинные фикстуры, магические
# числа в ассертах, «слишком много» локальных переменных в сценарии. Отчёт по ним
# не сообщал бы ничего, кроме того, что это тесты.
per-file-ignores =
    */tests/*:WPS
    */conftest.py:WPS
