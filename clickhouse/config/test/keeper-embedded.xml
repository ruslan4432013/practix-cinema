<!--
  Keeper, встроенный в тот же процесс сервера.

  В боевой топологии так делать нельзя: встроенный Keeper падает вместе с
  сервером, и кворум координации разделяет судьбу того, что он координирует.
  Но тестовому стенду нужен именно он: Replicated*MergeTree и ON CLUSTER без
  Keeper не работают вовсе, а поднимать три отдельных контейнера ради тестов
  значило бы утроить время старта CI.
-->
<clickhouse>
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server><id>1</id><hostname>clickhouse</hostname><port>9234</port></server>
        </raft_configuration>
    </keeper_server>

    <zookeeper>
        <node>
            <host>clickhouse</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
</clickhouse>
