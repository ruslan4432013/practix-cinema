<!--
  Тестовый узел живёт рядом с Kafka, Elasticsearch, Redis и двумя PostgreSQL
  в одном CI-раннере, поэтому память ограничена жёстче боевого стенда.
-->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.2</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>134217728</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_concurrent_queries>20</max_concurrent_queries>
    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
