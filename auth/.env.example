PROJECT_NAME=auth_service

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AUTH_POSTGRES_DB=auth_database
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=secret
AUTH_POSTGRES_HOST=127.0.0.1
AUTH_POSTGRES_PORT=5432

JWT_SECRET_KEY=secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BASE_DIR=.

AUTHJWT_SECRET_KEY=secret
AUTHJWT_DENYLIST_ENABLED=True
AUTHJWT_DENYLIST_TOKEN_CHECKS=["access", "refresh"]
ACCESS_TOKEN_EXPIRES=3600
REFRESH_TOKEN_EXPIRES=2592000
DEFAULT_ROLE_NAME=user
SUPERUSER_ROLES=["admin", "superuser"]

# --- OAuth (вход через соцсети, сторона потребителя) ---
# Опциональная фича: включается флагом OAUTH_ENABLED.
# Значения — плейсхолдеры. Реальные креды в репозиторий не кладём: см.
# комментарий в корневом .env.example.
OAUTH_ENABLED=False
YANDEX_CLIENT_ID=<yandex-oauth-client-id>
YANDEX_CLIENT_SECRET=<yandex-oauth-client-secret>
YANDEX_REDIRECT_URI=http://localhost/api/v1/oauth/yandex/callback
