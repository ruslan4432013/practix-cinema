# Прямые зависимости сервиса. Полный закреплённый список (включая транзитивные)
# генерируется командой:
#   uv pip compile analytics_collector/requirements.in -c constraints.txt \
#       -o analytics_collector/requirements.txt --python-version 3.13
#
# Версии общих с auth/ и rest/ пакетов НЕ указываются здесь — они приходят из
# корневого constraints.txt. Расхождение версий FastAPI или Pydantic между
# сервисами одного репозитория — источник трудноуловимых различий в поведении
# валидации, и единственный способ его исключить — общий источник правды.

# --- Веб-слой ---
fastapi
uvicorn
pydantic
pydantic-settings

# --- Kafka ---
# aiokafka — нативно асинхронный клиент. Синхронный confluent-kafka пришлось бы
# выносить в пул потоков, что для ingest-сервиса на asyncio лишний слой.
aiokafka
# Кодеки сжатия для aiokafka. Начиная с 0.12 библиотека берёт lz4/zstd/snappy
# из cramjam, а НЕ из одноимённых пакетов: без cramjam aiokafka считает lz4
# недоступным и падает на старте продюсера.
cramjam==2.11.0

# --- Redis: буфер деградации, rate limit, дедупликация ---
redis

# --- Проверка JWT (та же библиотека и секрет, что в Auth-сервисе) ---
async-fastapi-jwt-auth

# --- Разбор User-Agent ---
user-agents==2.2.0

# --- Наблюдаемость ---
prometheus-client
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-http
opentelemetry-instrumentation-fastapi
# Прокидывает контекст трассировки в заголовки сообщений Kafka, благодаря чему
# трейс не обрывается на границе брокера.
opentelemetry-instrumentation-aiokafka==0.64b0

# --- Тесты ---
httpx
pytest
pytest-asyncio
