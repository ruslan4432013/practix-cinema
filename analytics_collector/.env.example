# Шаблон окружения сервиса сбора пользовательских действий.
# В docker-compose переменные приходят из корневого .env; этот файл нужен для
# локального запуска и как fallback внутри контейнера (см. entrypoint.sh).

# --- Общее ---
PROJECT_NAME=analytics-collector
# dev | test | prod. В prod включаются обязательные проверки безопасности:
# сервис не стартует с солью по умолчанию и с CORS "*".
UGC_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=True

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
KAFKA_CLIENT_ID=analytics-collector
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=True
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_LINGER_MS=20
KAFKA_MAX_BLOCK_MS=1000

# --- Топики ---
KAFKA_TOPIC_CLICKS=ugc.clicks.v1
KAFKA_TOPIC_PAGE_VIEWS=ugc.page_views.v1
KAFKA_TOPIC_VIDEO_EVENTS=ugc.video_events.v1
KAFKA_TOPIC_VIDEO_PROGRESS=ugc.video_progress.v1
KAFKA_TOPIC_SEARCH_EVENTS=ugc.search_events.v1
KAFKA_TOPIC_DLQ=ugc.events.dlq.v1

# --- Redis (буфер деградации, rate limit, дедупликация) ---
REDIS_HOST=redis
REDIS_PORT=6379
# Отдельная база, чтобы не пересекаться с кэшем Movies API и сессиями Auth.
UGC_REDIS_DB=1

# --- Буфер деградации ---
UGC_FALLBACK_ENABLED=True
UGC_FALLBACK_MAX_SIZE=100000
UGC_FALLBACK_DRAIN_INTERVAL=5.0
UGC_FALLBACK_DRAIN_BATCH=500
UGC_FALLBACK_MAX_ATTEMPTS=5

# --- Ограничения полезной нагрузки ---
UGC_MAX_BODY_BYTES=65536
UGC_MAX_BATCH_SIZE=50

# --- Дедупликация по event_id ---
UGC_DEDUP_ENABLED=True
UGC_DEDUP_TTL=600

# --- Rate limiting ---
UGC_RATE_LIMIT_ENABLED=True
UGC_RATE_LIMIT_TIMES=600
UGC_RATE_LIMIT_SECONDS=60

# --- Приватность ---
# ОБЯЗАТЕЛЬНО заменить перед выкаткой: соль по умолчанию делает хеши IP
# обратимыми радужной таблицей. При UGC_ENV=prod сервис с этим значением
# не стартует.
UGC_IP_HASH_SALT=dev-insecure-salt-change-me

# --- CORS: список источников через запятую ---
UGC_CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

# --- Проверка JWT (секрет общий с Auth-сервисом) ---
AUTHJWT_SECRET_KEY=secret

# --- Наблюдаемость ---
UGC_METRICS_ENABLED=True
OTEL_ENABLED=True
OTEL_SERVICE_NAME=analytics-collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
