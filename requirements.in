# Прямые зависимости образа Movies API (он же образ набора tests/functional/rest).
# Лок собирается отсюда с общими ограничениями репозитория:
#   uv pip compile requirements.in -c constraints.txt -o requirements.txt --python-version 3.13

# --- Веб-стек ---
fastapi
uvicorn
pydantic
pydantic-settings

# --- Хранилища ---
elasticsearch[async]
redis

# --- Аутентификация: токены проверяются локально, по общему секрету ---
async-fastapi-jwt-auth

# --- Межсервисные вызовы в Auth ---
httpx

# --- Трассировка ---
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-http
opentelemetry-instrumentation-fastapi
opentelemetry-instrumentation-httpx

# --- Тесты ---
# Ставятся в образ на этапе сборки, а не `pip install` в entrypoint: иначе
# каждый прогон мог бы получить другую версию pytest.
pytest
pytest-asyncio
aiohttp
pyjwt
