# Прямые зависимости ETL. Лок собирается с общими ограничениями репозитория:
#   uv pip compile etl_clickhouse/requirements.in -c constraints.txt \
#       -o etl_clickhouse/requirements.txt --python-version 3.13
#
# Версии пакетов, общих с остальными сервисами, живут в корневом
# constraints.txt и здесь намеренно не дублируются.

# --- Источник ---
aiokafka
# Коллектор публикует с compression_type='lz4'. Без кодека консьюмер падает на
# первом же батче — aiokafka использует cramjam для lz4/zstd/snappy.
cramjam==2.11.0

# --- Приёмник ---
# HTTP-драйвер ClickHouse. Выбран вместо native clickhouse-driver: HTTP-порт
# 8123 уже открыт для healthcheck'ов, есть штатная поддержка
# insert_deduplication_token, а разница в скорости на батчах в десятки тысяч
# строк несущественна на фоне сети.
# Экстра [async] тянет aiohttp: начиная с 1.x AsyncClient — настоящий
# асинхронный клиент поверх aiohttp, а не обёртка синхронного в пул потоков.
# Без экстры импорт clickhouse_connect.driver.asyncclient падает.
clickhouse-connect[async]==1.6.0

# --- Конфигурация ---
pydantic
pydantic-settings

# --- Наблюдаемость ---
prometheus-client
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-http
# Восстанавливает контекст трейса из заголовков сообщений Kafka: без неё
# цепочка «браузер -> коллектор -> Kafka» обрывается на границе брокера.
opentelemetry-instrumentation-aiokafka

# --- Тесты ---
pytest
pytest-asyncio
