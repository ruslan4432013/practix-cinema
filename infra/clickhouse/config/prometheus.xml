<!--
  Встроенный экспортёр метрик ClickHouse. Без этой секции у сервера нет
  эндпоинта /metrics, и Prometheus видел бы только ETL, но не хранилище —
  а «данные не доехали» и «хранилище задыхается» выглядят одинаково, пока
  нет метрик обеих сторон.
-->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <errors>true</errors>
    </prometheus>
</clickhouse>
