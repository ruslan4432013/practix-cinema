<!--
  Узел кворума ClickHouse Keeper (Raft).

  Три узла, а не один: Keeper — единственный сервис, отказ которого
  останавливает ВСЕ вставки в реплицируемые таблицы и любой ON CLUSTER-DDL.
  При единственном узле «две реплики на шард» не значат ничего: потеря
  координатора кладёт хранилище целиком. Кворум из трёх переживает потерю
  одного узла, а стоит недорого — Keeper занимает десятки мегабайт против
  сотен у сервера ClickHouse.
-->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <logger>
        <level>information</level>
        <console>true</console>
    </logger>
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>2</server_id>
        <log_storage_path>/var/lib/clickhouse-keeper/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse-keeper/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server><id>1</id><hostname>clickhouse-keeper-01</hostname><port>9234</port></server>
            <server><id>2</id><hostname>clickhouse-keeper-02</hostname><port>9234</port></server>
            <server><id>3</id><hostname>clickhouse-keeper-03</hostname><port>9234</port></server>
        </raft_configuration>
    </keeper_server>
</clickhouse>
