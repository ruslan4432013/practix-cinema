{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "movies-api",
  "projectType": "application",
  "sourceRoot": "apps/movies-api/src",
  "tags": [
    "lang:python",
    "scope:movies",
    "type:app"
  ],
  "targets": {
    "lint": {},
    "docker": {
      "options": {
        "command": "docker buildx build -f infra/docker/python-service.Dockerfile --target movies-api --build-arg PACKAGE=practix-movies-api --load -t practix/movies-api:local ."
      }
    },
    "test-functional": {
      "inputs": [
        "python",
        "pythonTests",
        "^python",
        "sharedGlobals",
        "{workspaceRoot}/infra/compose/**",
        "{workspaceRoot}/infra/docker/**"
      ],
      "options": {
        "commands": [
          "docker compose -f infra/compose/docker-compose.test.yml --project-directory infra/compose run --rm --build tests",
          "docker compose -f infra/compose/docker-compose.test.yml --project-directory infra/compose down -v"
        ]
      }
    }
  }
}
