# ВНИМАНИЕ: этот файл больше НЕ попадает в образ.
#
# После перехода на один infra/docker/python-service.Dockerfile в образ
# копируется КОРНЕВОЙ .env.example, и именно он — источник значений по умолчанию
# для всех сервисов. Файл оставлен как удобная шпаргалка «что нужно именно этому
# сервису», но добавлять сюда новые обязательные ключи бессмысленно: сервис их
# не увидит. Добавляй в корневой .env.example.
#
# Значения по умолчанию для локального запуска сервиса без корневого .env.
# В docker-compose переменные приходят из корневого .env (env_file), а этот
# файл копируется entrypoint.sh только если .env не пробросили.

ETL_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=True

# --- Kafka: источник ---
KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
ETL_CONSUMER_GROUP=ugc-clickhouse-etl
ETL_CLIENT_ID=etl-clickhouse
ETL_AUTO_OFFSET_RESET=earliest
KAFKA_TOPIC_CLICKS=ugc.clicks.v1
KAFKA_TOPIC_PAGE_VIEWS=ugc.page_views.v1
KAFKA_TOPIC_VIDEO_EVENTS=ugc.video_events.v1
KAFKA_TOPIC_VIDEO_PROGRESS=ugc.video_progress.v1
KAFKA_TOPIC_SEARCH_EVENTS=ugc.search_events.v1
KAFKA_TOPIC_DLQ=ugc.events.dlq.v1

# --- Батчинг ---
ETL_MAX_RECORDS=5000
ETL_BATCH_MAX_ROWS=10000
ETL_BATCH_MAX_BYTES=33554432
ETL_FLUSH_INTERVAL=2.0
ETL_POLL_TIMEOUT_MS=500
# Реальный драйвер RSS — буферы выборки, а не размер пачки.
ETL_MAX_PARTITION_FETCH_BYTES=1048576
ETL_FETCH_MAX_BYTES=16777216
ETL_MAX_POLL_INTERVAL_MS=300000
ETL_SESSION_TIMEOUT_MS=30000
ETL_MAX_SCHEMA_VERSION=1

# --- ClickHouse: приёмник ---
CH_HOSTS=clickhouse-01:8123,clickhouse-03:8123
CH_DATABASE=ugc
CH_USER=etl
CH_PASSWORD=etl
CH_CONNECT_TIMEOUT=5
CH_SEND_RECEIVE_TIMEOUT=60
CH_CONNECTOR_LIMIT=8
CH_INSERT_QUORUM=2
CH_INSERT_MAX_ATTEMPTS=0
CH_RETRY_START_DELAY=0.5
CH_RETRY_FACTOR=2
CH_RETRY_MAX_DELAY=30.0
CH_HEALTH_INTERVAL=10.0

# --- Наблюдаемость и контроль памяти ---
ETL_METRICS_ENABLED=True
ETL_METRICS_PORT=8000
ETL_LAG_INTERVAL=15.0
ETL_MEMORY_CHECK_INTERVAL=30.0
ETL_RSS_WARN_MB=512
# tracemalloc удваивает стоимость аллокации — включать только на время
# расследования утечки.
ETL_TRACEMALLOC_ENABLED=False
ETL_TRACEMALLOC_INTERVAL=300.0
ETL_TRACEMALLOC_TOP_N=10
