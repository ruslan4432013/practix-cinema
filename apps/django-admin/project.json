{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "django-admin",
  "projectType": "application",
  "sourceRoot": "apps/django-admin",
  "tags": [
    "lang:python",
    "scope:admin",
    "type:app",
    "runtime:py312"
  ],
  "targets": {
    "lint": {},
    "test": {
      "inputs": [
        "python",
        "{projectRoot}/pytest.ini",
        "{projectRoot}/uv.lock",
        "{workspaceRoot}/pyproject.toml"
      ],
      "options": {
        "cwd": "apps/django-admin",
        "command": "uv run --group test pytest",
        "env": {
          "UV_PYTHON": "3.12",
          "VIRTUAL_ENV": ""
        }
      }
    },
    "docker": {
      "options": {
        "command": "docker buildx build -f apps/django-admin/Dockerfile --load -t practix/django-admin:local apps/django-admin"
      }
    }
  }
}
